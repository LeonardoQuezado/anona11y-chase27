GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here
XAI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Correction model (the /correcao page lets you pick it per run; these are the defaults
# for `python src/corrector.py` on the host). Providers: labserver, ollama, openai,
# anthropic, gemini, groq, deepseek, xai, custom (any OpenAI-compatible server).
# Online providers use the {NAME}_API_KEY above unless CORRECTOR_API_KEY is set.
CORRECTOR_PROVIDER=labserver
CORRECTOR_API_KEY=
CORRECTOR_MODEL=
CORRECTOR_BASE_URL=

# Lab server with Open WebUI — Qwen3-Coder correction stage (run corrector.py on the HOST if it needs VPN)
# Token: grab it from the browser's localStorage key "token" on the server's Open WebUI page
LAB_SERVER_BASE_URL=https://your-lab-server
LAB_SERVER_TOKEN=your_session_token_here
LAB_SERVER_MODEL=qwen3-coder-30b-a3b-instruct-fp8

# Android device for ATF instrumented tests (optional)
# 1. Enable USB debugging on your phone and connect via USB
# 2. Run from Windows CMD: adb connect <phone_wifi_ip>:5555  (accept dialog on phone)
# 3. Set the two vars below:
EMULATOR_HOST=host.docker.internal
# ADB keys dir — lets Docker use the same trusted keys as Windows.
# Use forward slashes. Example: C:/Users/<your_user>/.android
ADB_KEYS_DIR=
